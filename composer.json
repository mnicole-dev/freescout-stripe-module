{
  "name": "mnicole-dev/freescout-stripe-module",
  "description": "FreeScout module showing a customer's Stripe data (subscriptions, invoices, payments) in the conversation sidebar.",
  "license": "AGPL-3.0-only",
  "keywords": ["freescout", "stripe", "helpdesk", "module"],
  "require": {
    "php": ">=8.1",
    "stripe/stripe-php": "^17.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "replace": {
    "laravel/framework": "*"
  },
  "autoload": {
    "psr-4": { "Modules\\Stripe\\": "" }
  },
  "autoload-dev": {
    "psr-4": { "Modules\\Stripe\\Tests\\": "Tests/" }
  },
  "scripts": {
    "test": "phpunit"
  }
}
